{
  "name": "signcore",
  "version": "1.0.0",
  "private": true,
  "description": "SignCore: the shared specification database and admin for the Sign family of tools.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node scripts/db-setup.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "modules:export": "tsx scripts/modules/export.ts",
    "modules:check": "tsx scripts/modules/check.ts",
    "modules:publish": "tsx scripts/modules/publish.ts",
    "modules:roundtrip": "tsx scripts/modules/roundtrip.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "15.5.26",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.143.0",
    "yaml": "2.9.1"
  }
}
