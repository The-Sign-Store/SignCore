{
  // Cloudflare Workers config (OpenNext adapter). Deployed by Workers Builds when main changes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signcore",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Settings live in the Cloudflare dashboard (Worker > Settings > Variables and Secrets), not here,
  // so a deploy never overwrites them:
  //   AUTH_MODE=cloudflare-access, ACCESS_TEAM_DOMAIN, ACCESS_AUD, ACCESS_ALLOWED_GROUPS (text)
  //   DATABASE_URL (secret: the signcore_app connection, not the owner)
  "keep_vars": true
  // Once core.<your-domain> is added under Settings > Domains & Routes, you can turn off the workers.dev address:
  // "workers_dev": false
}
