# Neon connection string (Neon console > Connect > choose the "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/signcore?sslmode=require

# Login.
#   password           a sign-in page that checks APP_PASSWORD (local use and testing)
#   cloudflare-access  production: Cloudflare Access (signing in through Authentik) in front of the app.
#                      The app verifies the Access token on every request.
AUTH_MODE=password
# cloudflare-access only:
ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUD=application-audience-tag-from-the-access-application
# Optional: comma-separated Authentik groups allowed in (needs the groups claim passed through Access)
ACCESS_ALLOWED_GROUPS=
# password mode only:
APP_PASSWORD=change-me
# Any long random string, used to sign the login cookie
SESSION_SECRET=replace-with-a-long-random-string
