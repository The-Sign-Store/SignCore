# Neon connection string (Neon console > Connect > choose the "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/signcore?sslmode=require

# Login. AUTH_MODE=password shows a sign-in page that checks APP_PASSWORD.
# AUTH_MODE=cloudflare-access trusts Cloudflare Access (only use it when Access protects the whole site).
AUTH_MODE=password
APP_PASSWORD=change-me
# Any long random string, used to sign the login cookie
SESSION_SECRET=replace-with-a-long-random-string
